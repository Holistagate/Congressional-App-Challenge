{
  "name": "mealbridge-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import ./tests/hooks.mjs --test tests/*.test.ts",
    "db:setup": "node scripts/db-setup.mjs",
    "db:reset": "node scripts/db-setup.mjs --reset",
    "zips": "node scripts/build-zip-table.mjs",
    "assets": "node scripts/build-assets.mjs",
    "worker": "node scripts/worker.mjs",
    "setup": "node scripts/db-setup.mjs && echo \"\nReady. Run: npm run dev\""
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
